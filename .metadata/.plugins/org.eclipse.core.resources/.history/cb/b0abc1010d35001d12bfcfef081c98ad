package deneme;

public class calisan {
private String ad;
private String soyad;
private int mas; 

protected calisan(String ad,String soyad,int mas) {
this.ad = ad;
this.soyad = soyad;
this.mas = mas;
}

public String getAd() {
	return ad;
}

public void setAd(String ad) {
	this.ad = ad;
}

public String getSoyad() {
	return soyad;
}

public void setSoyad(String soyad) {
	this.soyad = soyad;
}

public int getMas() {
	return mas;
}

public void setMas(int mas) {
	this.mas = mas;
}
public void bilgiler() {
	System.out.println("Bilgiler: "+ad+soyad+mas);
}

}